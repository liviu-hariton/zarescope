  "typography": {
    "fonts": {
      "ui": "Inter (OFL) 400/500/600",
      "mono": "JetBrains Mono (OFL) 400/500",
      "wordmark": "Space Grotesk 500 (logo only; already outlined in the SVGs)"
    },
    "glyphRanges": "Basic Latin, Latin-1, Latin Extended-A, U+0218-U+021B (Ș ș Ț ț comma-below), U+2009 thin space, U+2212 minus, U+2013-U+2014, U+00B0 degree, U+2191-U+2193 arrows",
    "scale": {
      "display": {
        "font": "ui",
        "weight": 600,
        "size": 32,
        "lineHeight": 38,
        "tracking": -0.01
      },
      "title": {
        "font": "ui",
        "weight": 600,
        "size": 22,
        "lineHeight": 28
      },
      "heading": {
        "font": "ui",
        "weight": 600,
        "size": 17,
        "lineHeight": 24
      },
      "body": {
        "font": "ui",
        "weight": 400,
        "size": 15,
        "lineHeight": 22,
        "default": true
      },
      "label": {
        "font": "ui",
        "weight": 500,
        "size": 14,
        "lineHeight": 18
      },
      "caption": {
        "font": "ui",
        "weight": 500,
        "size": 12,
        "lineHeight": 16,
        "tracking": 0.06,
        "uppercase": true
      },
      "mono/freq": {
        "font": "mono",
        "weight": 500,
        "size": 40,
        "lineHeight": 44
      },
      "mono/freq-compact": {
        "font": "mono",
        "weight": 500,
        "size": 30,
        "lineHeight": 34
      },
      "mono/data": {
        "font": "mono",
        "weight": 400,
        "size": 14,
        "lineHeight": 20
      },
      "mono/small": {
        "font": "mono",
        "weight": 400,
        "size": 12,
        "lineHeight": 16
      }
    }
  },
  "spacing": {
    "2": 2,
    "4": 4,
    "8": 8,
    "12": 12,
    "16": 16,
    "24": 24,
    "32": 32,
    "48": 48
  },
  "radius": {
    "xs": 3,
    "sm": 4,
    "md": 6,
    "lg": 10,
    "xl": 14,
    "pill": 999
  },
  "border": {
    "default": 1,
    "focus": 2,
    "focusOffset": 2
  },
  "shadow": {
    "popup": {
      "dark": "0 8 24 #000000 @45%",
      "light": "0 6 20 #121624 @14%",
      "fallback": "border/strong 1px"
    }
  },
  "size": {
    "control": 36,
    "controlCompact": 28,
    "hitTarget": 44,
    "tableRow": 44,
    "tableRowCompact": 40,
    "titleBar": 28,
    "topBar": 64,
    "recordBanner": 48,
    "bannerProgress": 4,
    "statusBar": 28,
    "toggleWidth": 36,
    "toggleHeight": 20,
    "toggleKnob": 14,
    "sidePanel": 420,
    "meterSegmentsTopBar": 24,
    "meterSegmentsFull": 30,
    "icon": [
      16,
      20,
      24
    ]
  },
  "imgui": {
    "style": {
      "WindowPadding": [
        16,
        16
      ],
      "FramePadding": [
        10,
        8
      ],
      "ItemSpacing": [
        8,
        8
