      "FrameBorderSize": 1,
      "PopupBorderSize": 1,
      "TabBorderSize": 0,
      "GrabMinSize": 14,
      "ScrollbarSize": 12
    },
    "colors": {
      "Text": "text/primary",
      "TextDisabled": "text/disabled",
      "WindowBg": "bg/base",
      "ChildBg": "bg/surface",
      "PopupBg": "bg/raised",
      "Border": "border/subtle",
      "BorderShadow": "transparent",
      "FrameBg": "bg/raised",
      "FrameBgHovered": "bg/hover",
      "FrameBgActive": "bg/hover",
      "TitleBg": "bg/surface",
      "TitleBgActive": "bg/surface",
      "TitleBgCollapsed": "bg/surface",
      "MenuBarBg": "bg/surface",
      "ScrollbarBg": "bg/surface",
      "ScrollbarGrab": "border/strong",
      "ScrollbarGrabHovered": "border/input",
      "ScrollbarGrabActive": "text/secondary",
      "CheckMark": "accent",
      "SliderGrab": "accent",
      "SliderGrabActive": "accent/pressed",
      "Button": "bg/raised",
      "ButtonHovered": "bg/hover",
      "ButtonActive": "border/strong",
      "Header": "accent/soft",
      "HeaderHovered": "bg/hover",
      "HeaderActive": "accent/soft",
      "Separator": "border/subtle",
      "SeparatorHovered": "border/input",
      "SeparatorActive": "accent",
      "ResizeGrip": "transparent",
      "ResizeGripHovered": "border/input",
      "ResizeGripActive": "accent",
      "Tab": "bg/surface",
      "TabHovered": "bg/hover",
      "TabSelected": "bg/surface",
      "TabSelectedOverline": "accent",
      "TabDimmed": "bg/surface",
      "TabDimmedSelected": "bg/surface",
      "PlotLines": "accent",
      "PlotLinesHovered": "accent/hover",
      "PlotHistogram": "accent",
      "PlotHistogramHovered": "accent/hover",
      "TableHeaderBg": "bg/surface",
      "TableBorderStrong": "border/strong",
      "TableBorderLight": "border/subtle",
      "TableRowBg": "transparent",
      "TableRowBgAlt": "transparent",
      "TextSelectedBg": "accent/soft",
      "DragDropTarget": "accent",
      "NavCursor": "focus-ring",
      "NavWindowingHighlight": "accent",
      "NavWindowingDimBg": "#000000 @50%",
      "ModalWindowDimBg": "#000000 @50%"
    },
    "notes": "Primary button = accent bg + on-accent text, drawn with PushStyleColor(Button/ButtonHovered/ButtonActive = accent/accent-hover/accent-pressed, Text = on-accent). Danger button = error + on-error. Active tab is marked by a 2-px accent line under the tab (TabSelectedOverline drawn at the bottom). Load fonts at size*framebufferScale and set FontGlobalScale = 1/framebufferScale."
  }
}
